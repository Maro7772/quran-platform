// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum RecordingAccessMode {
  ALL_ACTIVE_STUDENTS
  ATTENDEES_ONLY
  SELECTED_STUDENTS
}

enum RecordingStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

model User {
  id              String            @id @default(uuid())
  name            String
  email           String?           @unique
  phone           String
  passwordHash    String
  role            Role              @default(STUDENT)
  status          UserStatus        @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  enrollments     Enrollment[]
  attendance      Attendance[]
  recordingAccess RecordingAccess[]

  @@index([phone])
}

model Program {
  id          String        @id @default(uuid())
  title       String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enrollments Enrollment[]
  sessions    LiveSession[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  programId String
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  program   Program  @relation(fields: [programId], references: [id])
}

model LiveSession {
  id              String        @id @default(uuid())
  programId       String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int
  meetingUrl      String?
  status          String        @default("SCHEDULED")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  program         Program       @relation(fields: [programId], references: [id])
  attendance      Attendance[]
  recordings      Recording[]
  notes           TeacherNote[]
}

model Attendance {
  id        String           @id @default(uuid())
  sessionId String
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  session   LiveSession      @relation(fields: [sessionId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model Recording {
  id           String              @id @default(uuid())
  sessionId    String
  title        String
  storageKey   String
  publishedAt  DateTime?
  expiresAt    DateTime?
  accessMode   RecordingAccessMode
  status       RecordingStatus     @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  session      LiveSession         @relation(fields: [sessionId], references: [id])
  allowedUsers RecordingAccess[]
}

model RecordingAccess {
  id          String    @id @default(uuid())
  recordingId String
  userId      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  recording   Recording @relation(fields: [recordingId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([recordingId, userId])
}

model TeacherNote {
  id        String      @id @default(uuid())
  sessionId String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  session   LiveSession @relation(fields: [sessionId], references: [id])
}

model PasswordReset {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  code      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([token])
}

